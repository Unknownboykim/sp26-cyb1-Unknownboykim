#!/bin/sh
#
# Pre-commit hook to run Spotless code formatter
# This hook automatically formats Java files before commit
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}Running Spotless formatter...${NC}"

# Get the project root directory (where gradlew is located)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT" || exit 1

# Check if gradlew exists
if [ ! -f "./gradlew" ]; then
  echo "${YELLOW}Warning: gradlew not found. Skipping Spotless check.${NC}"
  exit 0
fi

# Check if there are any Java files staged
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(java|gradle)$' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
  echo "${GREEN}No Java or Gradle files staged. Skipping Spotless.${NC}"
  exit 0
fi

echo "${GREEN}Formatting staged files with Spotless...${NC}"

# Run Spotless apply
./gradlew spotlessApply --quiet --no-daemon

# Check if Spotless made any changes
CHANGED_FILES=$(git diff --name-only)

if [ -n "$CHANGED_FILES" ]; then
  echo "${YELLOW}Spotless formatted some files. Re-staging formatted files...${NC}"
  
  # Re-stage the formatted files
  echo "$CHANGED_FILES" | grep -E '\.(java|gradle)$' | while read -r file; do
    if [ -n "$file" ]; then
      git add "$file"
      echo "  - Re-staged: $file"
    fi
  done
  
  echo "${GREEN}✓ Files have been formatted and re-staged.${NC}"
else
  echo "${GREEN}✓ All files are already properly formatted.${NC}"
fi

exit 0

